pragma solidity ^0.8.24;
import {Test} from "forge-std/Test.sol";import {Auction} from "../src/vulnerable/Auction.sol";import {AuctionFixed} from "../src/fixed/AuctionFixed.sol";
contract AuctionLabTest is Test {address seller=makeAddr("seller");address alice=makeAddr("alice");address bob=makeAddr("bob");function test_Exploit_PublicBidCanBeOutbid() public {vm.prank(seller);Auction a=new Auction(1 days);vm.deal(alice,3 ether);vm.deal(bob,3 ether);vm.prank(alice);a.bid{value:1 ether}();vm.prank(bob);a.bid{value:1 ether+1 wei}();assertEq(a.highestBidder(),bob);}function test_Fixed_CommitRevealWorks() public {vm.prank(seller);AuctionFixed a=new AuctionFixed(1 hours,1 hours);bytes32 sa=keccak256("alice-secret");bytes32 sb=keccak256("bob-secret");vm.deal(alice,3 ether);vm.deal(bob,3 ether);vm.prank(alice);a.commitBid{value:2 ether}(a.commitmentFor(alice,1 ether,sa));vm.prank(bob);a.commitBid{value:2 ether}(a.commitmentFor(bob,1.5 ether,sb));vm.warp(block.timestamp+1 hours);vm.prank(alice);a.revealBid(1 ether,sa);vm.prank(bob);a.revealBid(1.5 ether,sb);assertEq(a.highestBidder(),bob);assertEq(a.highestBid(),1.5 ether);}function test_Fixed_CopiedRevealNotValidForOtherAddress() public {vm.prank(seller);AuctionFixed a=new AuctionFixed(1 hours,1 hours);bytes32 salt=keccak256("secret");vm.deal(alice,2 ether);vm.prank(alice);a.commitBid{value:2 ether}(a.commitmentFor(alice,1 ether,salt));vm.warp(block.timestamp+1 hours);vm.prank(bob);vm.expectRevert(bytes("no commitment"));a.revealBid(1 ether,salt);}}
