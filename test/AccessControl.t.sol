pragma solidity ^0.8.24;
import {Test} from "forge-std/Test.sol";import {AccessControl} from "../src/vulnerable/AccessControl.sol";import {AccessControlFixed} from "../src/fixed/AccessControlFixed.sol";
contract AccessControlLabTest is Test {address owner=makeAddr("owner");address attacker=makeAddr("attacker");function test_Exploit_UnauthorizedChanges() public {vm.prank(owner);AccessControl c=new AccessControl(owner);vm.prank(attacker);c.setFee(9000);vm.prank(attacker);c.setTreasury(attacker);assertEq(c.feeBps(),9000);assertEq(c.treasury(),attacker);}function test_Fixed_UnauthorizedChangesBlocked() public {vm.prank(owner);AccessControlFixed c=new AccessControlFixed(owner);vm.prank(attacker);vm.expectRevert(bytes("not owner"));c.setFee(9000);vm.prank(attacker);vm.expectRevert(bytes("not owner"));c.setTreasury(attacker);assertEq(c.feeBps(),0);assertEq(c.treasury(),owner);}function test_Fixed_OwnerCanUpdate() public {AccessControlFixed c=new AccessControlFixed(owner);c.setFee(250);c.setTreasury(attacker);assertEq(c.feeBps(),250);assertEq(c.treasury(),attacker);}}
