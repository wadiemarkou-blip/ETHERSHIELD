pragma solidity ^0.8.24;
import {Test} from "forge-std/Test.sol";import {RefundDoS} from "../src/vulnerable/RefundDoS.sol";import {RefundDoSFixed} from "../src/fixed/RefundDoSFixed.sol";import {RefundDoSAttacker} from "./Attackers.sol";
contract RefundDoSLabTest is Test {address alice=makeAddr("alice");function test_Exploit_RejectingLeaderBlocksBid() public {RefundDoS a=new RefundDoS();RefundDoSAttacker bad=new RefundDoSAttacker(address(a));bad.placeBid{value:1 ether}();vm.deal(alice,2 ether);vm.prank(alice);vm.expectRevert(bytes("refund failed"));a.bid{value:2 ether}();assertEq(a.currentLeader(),address(bad));}function test_Fixed_RejectingLeaderCannotBlockBid() public {RefundDoSFixed a=new RefundDoSFixed();RefundDoSAttacker bad=new RefundDoSAttacker(address(a));bad.placeBid{value:1 ether}();vm.deal(alice,2 ether);vm.prank(alice);a.bid{value:2 ether}();assertEq(a.currentLeader(),alice);assertEq(a.pendingReturns(address(bad)),1 ether);}}
