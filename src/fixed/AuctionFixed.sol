pragma solidity ^0.8.24;
/// Commit-reveal reduces copying of visible bids; it does not eliminate every MEV vector.
contract AuctionFixed {address public immutable seller;uint256 public immutable commitEnd;uint256 public immutable revealEnd;address public highestBidder;uint256 public highestBid;mapping(address=>bytes32) public commitments;mapping(address=>uint256) public deposits;mapping(address=>bool) public revealed;mapping(address=>uint256) public pendingRefunds;bool public proceedsWithdrawn;bool private locked;modifier nonReentrant(){require(!locked,"reentrant");locked=true;_;locked=false;}constructor(uint256 c,uint256 r){require(c>0&&r>0,"invalid duration");seller=msg.sender;commitEnd=block.timestamp+c;revealEnd=commitEnd+r;}function commitmentFor(address bidder,uint256 amount,bytes32 salt) public view returns(bytes32){return keccak256(abi.encode(bidder,amount,salt,block.chainid,address(this)));}function commitBid(bytes32 commitment) external payable {require(block.timestamp<commitEnd,"commit ended");require(commitment!=bytes32(0),"empty commitment");require(msg.value>0,"deposit required");require(commitments[msg.sender]==bytes32(0),"already committed");commitments[msg.sender]=commitment;deposits[msg.sender]=msg.value;}function revealBid(uint256 amount,bytes32 salt) external {require(block.timestamp>=commitEnd&&block.timestamp<revealEnd,"not reveal phase");require(commitments[msg.sender]!=bytes32(0),"no commitment");require(!revealed[msg.sender],"already revealed");require(amount<=deposits[msg.sender],"bid exceeds deposit");require(commitments[msg.sender]==commitmentFor(msg.sender,amount,salt),"invalid reveal");revealed[msg.sender]=true;if(amount>highestBid){if(highestBidder!=address(0))pendingRefunds[highestBidder]+=deposits[highestBidder];highestBidder=msg.sender;highestBid=amount;}else{pendingRefunds[msg.sender]+=deposits[msg.sender];}}function claimRefund() external nonReentrant {require(block.timestamp>=revealEnd,"auction not ended");uint256 amount=pendingRefunds[msg.sender];if(commitments[msg.sender]!=bytes32(0)&&!revealed[msg.sender]){amount+=deposits[msg.sender];deposits[msg.sender]=0;}else if(msg.sender==highestBidder&&revealed[msg.sender]){uint256 excess=deposits[msg.sender]-highestBid;amount+=excess;deposits[msg.sender]=highestBid;}require(amount>0,"nothing to refund");pendingRefunds[msg.sender]=0;(bool ok,)=payable(msg.sender).call{value:amount}("");require(ok,"refund failed");}function withdrawProceeds() external nonReentrant {require(msg.sender==seller,"not seller");require(block.timestamp>=revealEnd,"auction not ended");require(!proceedsWithdrawn,"already withdrawn");proceedsWithdrawn=true;(bool ok,)=payable(seller).call{value:highestBid}("");require(ok,"proceeds failed");}}
