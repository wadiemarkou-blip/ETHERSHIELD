pragma solidity ^0.8.24;
contract AccessControlFixed {address public owner;uint256 public feeBps;address public treasury;event FeeUpdated(uint256 oldFee,uint256 newFee);event TreasuryUpdated(address oldTreasury,address newTreasury);modifier onlyOwner(){require(msg.sender==owner,"not owner");_;}constructor(address t){require(t!=address(0),"zero treasury");owner=msg.sender;treasury=t;}function setFee(uint256 f) external onlyOwner {require(f<=10000,"fee too high");uint256 old=feeBps;feeBps=f;emit FeeUpdated(old,f);}function setTreasury(address t) external onlyOwner {require(t!=address(0),"zero treasury");address old=treasury;treasury=t;emit TreasuryUpdated(old,t);}function withdraw() external onlyOwner {(bool ok,)=payable(treasury).call{value:address(this).balance}("");require(ok,"send failed");}function transferOwnership(address n) external onlyOwner {require(n!=address(0));owner=n;}receive() external payable{}}
